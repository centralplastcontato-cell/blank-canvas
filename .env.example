# Referência das variáveis do projeto.
# ATENÇÃO: hoje o build NÃO lê estas variáveis — a URL e a chave anon do Supabase
# estão hardcoded em src/integrations/supabase/client.ts (arquivo gerado pela Lovable).
# Este arquivo existe só como documentação. Não é preciso configurar nada na Vercel.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key-publica-protegida-por-RLS>"
